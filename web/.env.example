# Optional when the web app and API are hosted on different origins.
# Prefer a same-origin reverse proxy for HttpOnly cookie sessions.
VITE_API_BASE_URL=

# Public Supabase anon key required by the Edge Function gateway.
# Never put the service_role key in a VITE_* variable.
VITE_SUPABASE_ANON_KEY=

# Local Supabase API URL for the Vite development proxy (server-only).
# API_PROXY_TARGET=http://127.0.0.1:54321
